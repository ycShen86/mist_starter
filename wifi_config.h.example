// wifi_config.h.example
// WiFi credentials configuration file template
// INSTRUCTIONS:
// 1. Copy this file and rename it to "wifi_config.h"
// 2. Update YOUR_WIFI_SSID and YOUR_WIFI_PASSWORD with your actual credentials
// 3. DO NOT commit wifi_config.h to version control (it's in .gitignore)

#ifndef WIFI_CONFIG_H
#define WIFI_CONFIG_H

// WiFi credentials
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// WiFi connection settings
#define WIFI_CONNECT_TIMEOUT 10000  // Timeout in milliseconds (10 seconds)
#define WIFI_RETRY_DELAY 5000       // Delay between retry attempts (5 seconds)

// Optional: Static IP configuration (comment out to use DHCP)
// #define USE_STATIC_IP
// #define STATIC_IP "192.168.1.100"
// #define GATEWAY "192.168.1.1"
// #define SUBNET "255.255.255.0"
// #define DNS1 "8.8.8.8"
// #define DNS2 "8.8.4.4"

#endif
